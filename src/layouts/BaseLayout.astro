---
import fontLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url'
import { getEntry } from 'astro:content'
import { SITE_URL } from '../site'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  home?: boolean
  ogType?: 'article' | 'website'
  publishedDate?: Date
  updatedDate?: Date
  index?: boolean
  ogImage?: string
}

const {
  title,
  description,
  home = false,
  ogType = 'website',
  publishedDate,
  updatedDate,
  index = true,
  ogImage = '/og/home.png',
} = Astro.props
const profile = await getEntry('site', 'profile')

if (!profile)
  throw new Error('Missing required site profile at src/content/site/profile.json')

const pageTitle = title ? `${title} — ${profile.data.name}` : profile.data.homepage.title
const pageDescription = description ?? profile.data.homepage.description
const canonicalURL = new URL(Astro.url.pathname, SITE_URL)
const ogImageURL = new URL(ogImage, SITE_URL)
const currentYear = new Date().getFullYear()
const speculationRules = {
  prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f7f7f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151516" media="(prefers-color-scheme: dark)" />
    {index ? <link rel="canonical" href={canonicalURL} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title={profile.data.name} href="/feed.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.data.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {index && <meta property="og:url" content={canonicalURL} />}
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={pageTitle} />
    <title>{pageTitle}</title>
    <script is:inline type="speculationrules" set:html={JSON.stringify(speculationRules)} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <p class:list={[{ 'identity': !home, 'home-identity': home }]}>
          {home ? profile.data.name : <a href="/">{profile.data.name}</a>}
          <span class="cursor" aria-hidden="true"></span>
        </p>
        {
          home
            ? (
                <>
                  <p>Personal website</p>
                  <p><time datetime={String(currentYear)}>{currentYear}</time></p>
                </>
              )
            : <p><a href="/">← Back to home</a></p>
        }
      </header>
      <main id="content" class:list={{ 'home-content': home, 'inner-content': !home }}>
        <slot />
      </main>
      <footer class="site-footer">
        <p class="ornament">~*~ © {currentYear} {profile.data.name} ~*~</p>
      </footer>
    </div>
  </body>
</html>
